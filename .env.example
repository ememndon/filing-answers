# Copy this file to .env and fill in the values. .env is git-ignored and
# must never be committed — this repository is public.
#
#   cp .env.example .env
#
# Leave every value BLANK in this file. It is a template that ships with
# the repository, so anything written here is published. Use a key
# created for this project alone: sharing one key between a public demo
# and anything real means revoking it breaks both.

# Anthropic API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Which model answers questions. Small and cheap is the right choice
# here: the point of this project is the harness around the model, not
# the model itself.
ANSWER_MODEL=claude-haiku-4-5

# The SEC requires a contact address in the User-Agent of every request
# to EDGAR. Requests without one are refused, and the address is how they
# reach you if a program misbehaves, so it must be one you receive mail at.
# https://www.sec.gov/os/webmaster-faq#developers
SEC_USER_AGENT="filing-answers your-email@example.com"
